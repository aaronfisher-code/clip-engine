# Where OBS (or another recorder) writes replay-buffer clips.
CLIP_SOURCE_DIR=./data/inbox
CLIP_DATA_DIR=./data
PORT=4317

# Optional comma-separated fallback names when recordings only contain Track1, Track2, etc.
CLIP_AUDIO_TRACK_LABELS=Game / System,Discord,Microphone

# Branding shown on public clip pages and Discord embeds.
CLIP_SHARE_SITE_NAME=Dabs Clip Engine

# Cloudflare R2 (Dashboard > R2 > Manage R2 API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clips
R2_PUBLIC_BASE_URL=https://clips.dab.dev

# Export tuning. Slow libx264 provides the best H.264 quality at the stream-friendly
# 30 Mbps ceiling. NVIDIA h264_nvenc remains available when export speed matters.
FFMPEG_VIDEO_ENCODER=libx264
FFMPEG_PRESET=slow
FFMPEG_CRF=18
