# Where OBS (or another recorder) writes replay-buffer clips.
CLIP_SOURCE_DIR=./data/inbox
CLIP_DATA_DIR=./data
PORT=4317

# Cloudflare R2 (Dashboard > R2 > Manage R2 API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clips
R2_PUBLIC_BASE_URL=https://clips.dab.dev

# Export tuning. libx264 is universally playable; CRF 20 is high quality.
# For much faster NVIDIA exports, use h264_nvenc (quality maps to CQ).
FFMPEG_VIDEO_ENCODER=libx264
FFMPEG_PRESET=medium
FFMPEG_CRF=20
