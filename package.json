{
  "name": "clip-engine",
  "version": "1.0.13",
  "private": true,
  "type": "module",
  "workspaces": [
    "cloud",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "cargo run -p clip-engine",
    "dev:cloud": "npm --workspace @clip-engine/cloud run dev",
    "build:desktop": "node scripts/prepare-ffmpeg.mjs && cargo build -p clip-engine --release",
    "build:cloud": "npm --workspace @clip-engine/cloud run check",
    "check": "npm --workspace @clip-engine/contracts run check && npm --workspace @clip-engine/cloud run check && cargo check --workspace",
    "check:rust": "cargo check --workspace",
    "test": "npm --workspace @clip-engine/cloud test && cargo test --workspace",
    "test:rust": "cargo test --workspace",
    "format:rust": "cargo fmt --all -- --check",
    "package:desktop": "node scripts/prepare-ffmpeg.mjs && cargo packager -p clip-engine --release"
  }
}
